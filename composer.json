{
    "name": "mrnewport/laravel-docsign",
    "description": "Document Generation & E-Signatures for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MrNewport",
            "email": "admin@matthewnewport.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^11.0",
        "illuminate/database": "^11.0",
        "illuminate/view": "^11.0",
        "illuminate/config": "^11.0",
        "dompdf/dompdf": "^2.0",
        "knplabs/knp-snappy": "^1.4",
        "twig/twig": "^3.0",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "MrNewport\\LaravelDocSign\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MrNewport\\LaravelDocSign\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MrNewport\\LaravelDocSign\\Providers\\DocSignServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^9.9"
    }
}
