{
    "name": "mrnewport/laravel-docsign",
    "description": "Document Generation & E-Signatures for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MrNewport",
            "email": "admin@matthewnewport.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "illuminate/config": "^12.0 || ^13.0",
        "dompdf/dompdf": "^3.1.6",
        "knplabs/knp-snappy": "^1.4",
        "twig/twig": "^3.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "MrNewport\\LaravelDocSign\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MrNewport\\LaravelDocSign\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MrNewport\\LaravelDocSign\\Providers\\DocSignServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8",
        "mockery/mockery": "^1.6"
    },
    "scripts": {
        "test": "pest"
    }
}
